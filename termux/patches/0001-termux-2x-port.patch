 import { verifyArtifact, verifySimulationGraph } from "./verify-artifact"
 import { resolveOpencodePty } from "./opencode-pty"
 
+// opentuiAliasPlugin — remap bare @opentui/* imports to @androidtui/*.
+// Our fork replaces @opentui/* with @androidtui/* (native Android support).
+const opentuiAliasPlugin: BunPlugin = {
+  name: "opentui-alias",
+  setup(build) {
+    const remap: Record<string, string> = {
+      "@opentui/keymap": "@androidtui/keymap",
+      "@opentui/solid": "@androidtui/solid",
+      "@opentui/core": "@androidtui/core",
+    }
+    build.onResolve({ filter: /^@opentui\// }, (args) => {
+      const importer = args.importer || ""
+      if (!/@androidtui[/+]opentui-/.test(importer)) return null
+      for (const [from, to] of Object.entries(remap)) {
+        if (args.path === from || args.path.startsWith(from + "/")) {
+          const rewritten = to + args.path.slice(from.length)
+          const resolved = Bun.resolveSync(rewritten, path.dirname(importer))
+          return { path: resolved }
+        }
+      }
+      return null
+    })
+  },
+}
+
+
+
 const dir = path.resolve(import.meta.dirname, "..")
 const binary = "opencode"
 const outdir = path.resolve(
@@ -109,11 +136,16 @@ const pluginRuntimePlugin: BunPlugin = {
 }
 
