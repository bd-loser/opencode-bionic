From db1111da91ee65925b51007194747f95ffbe5030 Mon Sep 17 00:00:00 2001
From: opencode-bionic <bionic@build.local>
Date: Sun, 19 Jul 2026 16:59:04 +0600
Subject: [PATCH 3/3] termux: lazy-load @ff-labs/fff-bun

@ff-labs/fff-bun@0.9.4 declares os:[darwin,linux,win32] in package.json.
On Termux (process.platform === 'android') Bun silently skips the
package during install, so a static ESM import would throw at startup.
Fall back to require() inside try/catch so we can null-guard and let
opencode's existing ripgrep fallback take over.
---
 packages/core/src/filesystem/fff.bun.ts | 34 ++++++++++++++------
 1 file changed, 22 insertions(+), 12 deletions(-)

diff --git a/packages/core/src/filesystem/fff.bun.ts b/packages/core/src/filesystem/fff.bun.ts
index 9843419..a5fd420 100644
--- a/packages/core/src/filesystem/fff.bun.ts
+++ b/packages/core/src/filesystem/fff.bun.ts
@@ -1,17 +1,25 @@
-import {
-  FileFinder,
-  type DirItem,
-  type DirSearchResult,
-  type FileItem,
-  type GrepCursor,
-  type GrepMatch,
-  type GrepResult,
-  type InitOptions,
-  type MixedItem,
-  type MixedSearchResult,
-  type SearchResult,
+import type {
+  DirItem,
+  DirSearchResult,
+  FileItem,
+  GrepCursor,
+  GrepMatch,
+  GrepResult,
+  InitOptions,
+  MixedItem,
+  MixedSearchResult,
+  SearchResult,
 } from "@ff-labs/fff-bun"
 
+// Load optionally because the package is skipped on Android; absence uses ripgrep.
+type FileFinderType = typeof import("@ff-labs/fff-bun")["FileFinder"]
+let FileFinder: FileFinderType | null
+try {
+  FileFinder = require("@ff-labs/fff-bun").FileFinder
+} catch {
+  FileFinder = null
+}
+
 declare global {
   const FFF_LIBC: "gnu" | "musl"
 }
@@ -112,10 +120,12 @@ export interface Picker {
 }
 
 export function available() {
+  if (!FileFinder) return false
   return FileFinder.isAvailable()
 }
 
 export function create(opts: Init): Result<Picker> {
+  if (!FileFinder) return { ok: false, error: "fff-bun not installed on this platform (os restriction)" }
   const made = FileFinder.create(opts)
   if (!made.ok) return made
   const pick = made.value
